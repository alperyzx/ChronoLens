# ChronoLens Environment Configuration

# Google Gemini AI API Key (Required)
GOOGLE_GENAI_API_KEY=YOUR_APIKEY_HERE

# Alternative Google API Key
GOOGLE_API_KEY=YOUR_APIKEY_HERE

# Default Genkit model (change this value to switch models without code edits)
GENKIT_MODEL=googleai/gemini-3.1-flash-lite

# Cache Configuration (Optional)
# File-based cache is enabled by default to solve server restart issues
USE_FILE_CACHE=true

#firestore database credentials
MONGO_CREDENTIALS=mongodb://user:password@dbhostname:443/dbname?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

CACHE_ADMIN_PASSWORD=your_secure_password_here